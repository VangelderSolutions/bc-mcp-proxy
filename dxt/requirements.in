# Source-of-truth dependency declarations for the DXT bundle.
#
# This file is hand-edited. The fully-pinned lockfile (dxt/requirements.txt)
# is generated from this file by pip-compile:
#
#     python -m piptools compile dxt/requirements.in --strip-extras --resolver=backtracking -o dxt/requirements.txt
#
# From Windows, run it inside WSL Ubuntu (see below why Linux):
#
#     wsl -e bash -lc 'cd "/mnt/f/.../bc-mcp-proxy" && pip-compile --upgrade --output-file=dxt/requirements.txt --strip-extras dxt/requirements.in'
#
# The lockfile is what Snyk scans (and what the build script vendors into
# the .dxt). Pinning every transitive eliminates the discrepancy between
# Snyk's static resolver and pip's install-time resolver.
#
# COMPILE THE LOCKFILE ON LINUX. pip-compile resolves against the OS it runs
# on, so a Windows run adds Windows-only entries (pywin32, colorama). pip
# skips those on Linux via their markers, but Snyk's requirements.txt scanner
# ignores environment markers and fails the whole scan with "Missing required
# packages". A Linux-compiled lockfile omits them entirely, and the Windows
# .dxt build still picks them up as ordinary unpinned transitives.

# --- Direct runtime dependencies ----------------------------------------------
# mcp is capped below 2.0.0: the 2.x line drops the APIs this proxy builds on
# (mcp.client.streamable_http.streamablehttp_client, mcp.shared.exceptions.McpError).
# The floor is the fix version for SNYK-PYTHON-MCP-18016318 (Authorization Bypass
# Through User-Controlled Key) and SNYK-PYTHON-MCP-18016320 (Missing Origin
# Validation in WebSockets).
mcp>=1.28.1,<2.0.0
httpx>=0.28.0
msal>=1.38.0
msal-extensions>=1.3.0
exceptiongroup>=1.2.0; python_version < "3.11"

# pywin32 is a Windows-only transitive of mcp. Listing it here with an
# explicit sys_platform marker forces pip-compile to preserve the marker
# in the generated lockfile — without it, CI on Ubuntu fails to install
# the lockfile because pywin32 has no Linux wheels.
pywin32; sys_platform == "win32"

# --- Minimum-Python guards ----------------------------------------------------
# pip-compile resolves against the interpreter it runs on, so on 3.11+ it will
# happily pick transitives that have dropped our floor of 3.10. The .dxt build
# vendors a cp310 wheel set and fails hard when a pin has no 3.10 wheel, so cap
# anything that has moved past us. Revisit if requires-python is ever raised.
rpds-py<2026                 # 2026.x is requires-python >=3.11

# --- Transitive security floors (Snyk-flagged CVEs) ---------------------------
# These packages are pulled in by mcp / msal / httpx but ship vulnerable
# versions in their unconstrained transitive trees. We constrain to the
# patched floors here so pip-compile's resolution lands above them.
h11>=0.16.0                  # SNYK-PYTHON-H11-10293728: HTTP Request Smuggling
cryptography>=50.0.1         # SNYK-PYTHON-CRYPTOGRAPHY-* + CVE-2026-39892
pyjwt>=2.15.0                # SNYK-PYTHON-PYJWT-15518059 + -17053408
python-dotenv>=1.2.3         # SNYK-PYTHON-PYTHONDOTENV-16115271
python-multipart>=0.0.30     # SNYK-PYTHON-PYTHONMULTIPART-*
requests>=2.33.1             # SNYK-PYTHON-REQUESTS-*
starlette>=1.7.0             # SNYK-PYTHON-STARLETTE-*
urllib3>=2.8.0               # SNYK-PYTHON-URLLIB3-* (CVE-2026-44431/44432)
