# Copy to .env and fill in. .env is git-ignored.
# Anything you put here is read by bc_mcp_proxy when no matching CLI flag is supplied.

# ---- Required ----------------------------------------------------------------

# Azure Directory (tenant) ID — Microsoft Entra ID > Overview.
BC_TENANT_ID=

# Azure App Registration client (application) ID. The app needs:
#   - Delegated API permissions: Financials.ReadWrite.All, user_impersonation
#   - Authentication > "Allow public client flows" enabled
#   - A desktop redirect URL: ms-appx-web://Microsoft.AAD.BrokerPlugin/<client-id>
BC_CLIENT_ID=

# Business Central environment name as it appears in the BC admin center.
# Examples: Production, Sandbox, MyDevEnv
BC_ENVIRONMENT=Production

# Exact company name within the environment (case-sensitive).
# Example: "CRONUS USA", "My Company Ltd."
BC_COMPANY=

# ---- Optional ----------------------------------------------------------------

# Optional named MCP configuration in BC. Leave empty if you don't use one.
#BC_CONFIGURATION_NAME=

# Skip the device-code flow by supplying a pre-issued bearer token (testing only).
#BC_CUSTOM_AUTH_HEADER=

# BC MCP base URL.
# v28 / v29 (default): https://mcp.businesscentral.dynamics.com  ← Microsoft's
#                      single documented endpoint for every MCP client.
# v26 / v27 (legacy) : https://api.businesscentral.dynamics.com  ← uncomment for
#                      environments that haven't been upgraded yet.
# The proxy auto-detects the host and switches both the OAuth scope and
# the request headers (TenantId/EnvironmentName for v28+; path-based for v27).
# Non-ASCII Company / ConfigurationName values are Base64-encoded on the wire
# automatically (MCP SEP-2243) -- type them exactly as shown in BC.
#BC_BASE_URL=https://mcp.businesscentral.dynamics.com

# Override the OAuth scope. Leave commented to let the proxy auto-pick:
#   legacy api.* host → https://api.businesscentral.dynamics.com/.default
#   any other host    → https://mcp.businesscentral.dynamics.com/.default
#BC_TOKEN_SCOPE=

# Add title / readOnlyHint / destructiveHint to BC tools that lack them so
# Claude auto-approves reads and confirms writes. 0/false to forward verbatim.
#BC_ANNOTATE_TOOLS=1

# Forward resources/* and prompts/* (BC v28+ file references, v29 tools)
# in addition to tools/*. 0/false to expose tools only.
#BC_FORWARD_RESOURCES_PROMPTS=1

# Static tool mode only: after connecting, read one record from every List
# tool and hide the tools for pages the signed-in user may not read (plus
# their Create/Update/Delete siblings). One call per API page per connect;
# Business Central still enforces every call. Off by default.
#BC_HIDE_UNAUTHORIZED_TOOLS=0

# Let Claude run a tool in another company of the same environment through an
# optional 'company' argument, and list the user's companies with
# bc_list_companies. One upstream session per company; Business Central still
# enforces per-company permissions. Off by default (bound to BC_COMPANY).
#BC_ALLOW_COMPANY_SWITCH=0

# With the company switch on: limit it to these companies (API or display
# name, separated by semicolons -- names may contain commas). BC_COMPANY is
# always allowed. Unset = every company of the environment.
#BC_ALLOWED_COMPANIES=CRONUS BE;Demo Nutrisan

# Logging — DEBUG, INFO, WARNING, ERROR.
#BC_LOG_LEVEL=INFO

# Verbose internal logging.
#BC_DEBUG=0

# HTTP request timeout in seconds (default: 120).
# Raise to 240+ for BC v28 dynamic mode with Discover Additional Objects on
# — first-call catalog enumeration regularly takes 60s+ on cold start.
#BC_HTTP_TIMEOUT_SECONDS=120

# Server-Sent Events read timeout in seconds (default: 300).
#BC_SSE_TIMEOUT_SECONDS=300

# Override the MSAL token cache location/filename.
#BC_DEVICE_CACHE_LOCATION=
#BC_DEVICE_CACHE_NAME=bc_mcp_proxy
